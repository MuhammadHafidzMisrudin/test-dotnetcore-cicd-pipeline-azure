@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
    var maxSale = Model.Stats.SalesByMonth.Count > 0 ? Model.Stats.SalesByMonth.Max(s => s.Amount) : 1m;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="h3 mb-0">Dashboard</h1>
    <span class="text-muted">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</span>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-label">Total Revenue</div>
                <div class="stat-value">@Model.Stats.TotalRevenue.ToString("C")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-label">Total Orders</div>
                <div class="stat-value">@Model.Stats.TotalOrders.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-label">Total Customers</div>
                <div class="stat-value">@Model.Stats.TotalCustomers.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card h-100">
            <div class="card-body">
                <div class="stat-label">Conversion Rate</div>
                <div class="stat-value">@Model.Stats.ConversionRate.ToString("0.00")%</div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-header bg-white">
                <strong>Sales (last 6 months)</strong>
            </div>
            <div class="card-body">
                <div class="bar-chart">
                    @foreach (var month in Model.Stats.SalesByMonth)
                    {
                        var heightPercent = maxSale > 0 ? (double)(month.Amount / maxSale) * 100 : 0;
                        <div class="bar-chart-column">
                            <div class="bar-chart-value">@month.Amount.ToString("C0")</div>
                            <div class="bar-chart-bar" style="height:@(heightPercent.ToString("0.##"))%"></div>
                            <div class="bar-chart-label">@month.Month</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-header bg-white">
                <strong>Order Status Breakdown</strong>
            </div>
            <div class="card-body">
                @{
                    var statusGroups = Model.Stats.RecentOrders
                        .GroupBy(o => o.Status)
                        .Select(g => new { Status = g.Key, Count = g.Count() })
                        .OrderByDescending(g => g.Count);
                    var totalOrdersShown = Model.Stats.RecentOrders.Count;
                }
                <ul class="list-unstyled mb-0">
                    @foreach (var group in statusGroups)
                    {
                        var percent = totalOrdersShown > 0 ? (double)group.Count / totalOrdersShown * 100 : 0;
                        <li class="mb-3">
                            <div class="d-flex justify-content-between">
                                <span>@group.Status</span>
                                <span class="text-muted">@group.Count</span>
                            </div>
                            <div class="progress" role="progressbar" aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar status-@group.Status.ToLower()" style="width:@(percent.ToString("0.##"))%"></div>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header bg-white">
        <strong>Recent Orders</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.Stats.RecentOrders)
                    {
                        <tr>
                            <td>#@order.Id</td>
                            <td>@order.Customer</td>
                            <td>@order.Product</td>
                            <td class="text-end">@order.Amount.ToString("C")</td>
                            <td><span class="badge status-badge status-@order.Status.ToLower()">@order.Status</span></td>
                            <td>@order.Date.ToString("dd MMM yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
